{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.advancetecno.com.ar" }],
      "destination": "https://advancetecno.com.ar/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "advancetecno-landing.vercel.app" }],
      "destination": "https://advancetecno.com.ar/:path*",
      "statusCode": 301
    }
  ]
}
